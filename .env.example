# 复制为 .env 并填入真实值
# Vercel / Zeabur 部署时这些变量在控制台 → Settings → Environment Variables 配置

# 数据库（PostgreSQL）
# 生产环境需配两个连接串：
#   DATABASE_URL = pooled 连接串（-pooler 后缀，带 ?pgbouncer=true&sslmode=require）→ 应用运行时用
#   DIRECT_URL   = 直连串（不带 -pooler，带 ?sslmode=require）→ Prisma 迁移用
# Zeabur 部署时：创建 PostgreSQL 服务后，连接串会自动注入到 DATABASE_URL
# 若 Zeabur 未自动注入 DIRECT_URL，请手动添加（与 DATABASE_URL 相同即可）
# 本地开发两者填同一个本地连接串即可
DATABASE_URL="postgresql://user:password@localhost:5432/squad_signup?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/squad_signup?schema=public"

# NextAuth 密钥（生产必须改成强随机串）
# 生成：openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-change-in-production"

# 初始管理员：不在配置中创建。
# 由部署脚本在终端创建（install.sh / deploy.sh 首次部署时询问，
# 或手动执行：ADMIN_NICKNAME=admin ADMIN_PASSWORD=xxx npm run create-admin）。

# 服务端口（默认 3000；install.sh 安装时也可交互选择）
# PORT="3000"

# 战队名称前缀（可选，首次 seed 时写入数据库，默认空 = 无前缀）
# 用于登录用户名拼接（前缀+昵称）与站点标题；之后在管理后台「战队管理」中修改
# TEAM_PREFIX=""

# 上传文件持久目录（可选；默认 <应用目录>/uploads）
# 自托管建议指向独立目录，避免版本更新时图片丢失
# UPLOAD_DIR="/opt/squad-signup/uploads"

# 站点 URL（生产 = 部署平台分配的域名，如 https://xxx.zeabur.app）
NEXTAUTH_URL="http://localhost:3000"

# 信任 Host（用 IP 访问必须为 true；用 HTTPS 域名可设为 false）
# NextAuth v5 默认不信任非标准 host，自托管/IP/反向代理场景都建议 true
AUTH_TRUST_HOST="true"

# 是否信任反向代理传入的 X-Forwarded-For（用于登录/注册限流）。
# 部署在可信反向代理（Nginx/1Panel 等）后面时设为 true；直接暴露时必须 false。
TRUST_PROXY="true"

# ============ 多实例 / App 相关（可选）============

# 会话 Cookie 名（多实例部署在同一 IP 时必须各不相同，否则互相踢下线）
# 默认 authjs.session-token
# AUTH_COOKIE_NAME="squad_signup_session"

# HTTPS 部署时设为 true（Cookie 仅通过 HTTPS 传输）
# AUTH_COOKIE_SECURE="false"

# 极光推送（App 通知）。留空 = 推送功能静默关闭，网站/App 其余功能不受影响
# JPUSH_APPKEY=""
# JPUSH_MASTER_SECRET=""

# 临近提醒定时扫描密钥（systemd timer 每分钟调用 /api/notifications/tick 时携带）
# 生成：openssl rand -hex 16
# CRON_SECRET=""
